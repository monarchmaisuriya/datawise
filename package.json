{
  "name": "datawise",
  "private": true,
  "version": "0.1.0",
  "description": "A database client for Paseo: browse, query, edit, import and export PostgreSQL, MySQL, SQLite, SQL Server, Oracle, ClickHouse, MongoDB, Redis, Elasticsearch, Cassandra, DynamoDB and Neo4j.",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "README.md",
    "CHANGELOG.md",
    "datawise.png",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@mongodb-js/shell-bson-parser": "^1.6.3",
    "cassandra-driver": "^4.10.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "ioredis": "^6.0.0",
    "mongodb": "^7.8.0",
    "mssql": "^12.7.14",
    "mysql2": "^3.24.6",
    "neo4j-driver": "^6.3.0",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.15.1",
    "@tanstack/react-query": "^5.106.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/oracledb": "^26.0.1",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "~19.2.0",
    "@types/ssh2": "^1.15.6",
    "esbuild": "^0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
